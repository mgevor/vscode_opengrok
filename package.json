{
  "name": "vscode-opengrok",
  "repository": {
    "type": "git",
    "url": "https://github.com/mgevor/vscode_opengrok"
  },
  "publisher": "mgevor",
  "license": "SEE LICENSE IN LICENSE.txt",
  "displayName": "OpenGrok",
  "description": "Based on the 'OpenGrok Client for VS Code' project by @samwarring\nModified and build by @mgevor",
  "version": "1.0.5",
  "icon": "images/OpenGrokIcon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Search"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openGrok.search",
        "title": "OpenGrok: Search",
        "icon": "$(search)"
      },
      {
        "command": "openGrok.removeResultItem",
        "title": "OpenGrok: Remove",
        "icon": "$(search-remove)"
      },
      {
        "command": "openGrok.commandCopyRelativePath",
        "title": "OpenGrok: Copy relative path",
        "icon": "$(copy)"
      },
      {
        "command": "openGrok.copyBrowserLink",
        "title": "OpenGrok: Copy URL link",
        "icon": "$(link)"
      },
      {
        "command": "openGrok.openInEditor",
        "title": "OpenGrok: Open In Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "openGrok.login",
        "title": "OpenGrok: login",
        "icon": "$(login)"
      },
      {
        "command": "openGrok.saveResult",
        "title": "OpenGrok: Save Results",
        "icon": "$(save)"
      }
    ],
    "configuration": {
      "title": "OpenGrok",
      "properties": {
        "openGrok.serverURL": {
          "type": "string",
          "markdownDescription": "Full URL of the OpenGrok server. This must include the leading `http://` or `https://`.",
          "scope": "workspace"
        },
        "openGrok.defaultProjectNames": {
          "type": "array",
          "default": ["src"],
          "description": "Default project(s) used for search queries.",
          "scope": "workspace",
          "items": {
            "type": "string"
          }
        },
        "openGrok.keepRecentSearches": {
          "type": "number",
          "default": 1,
          "description": "Keep the results of this many recent searches in the results view. A value of 0 means unlimited. You will need to restart the extension ot apply the changes.",
          "scope": "workspace"
        },
        "openGrok.localRootDir": {
          "type": "string",
          "description": "Path to locate the search results in the local file system.",
          "scope": "workspace"
        }
      }
    },
    "keybindings": [
      {
        "command": "openGrok.search",
        "key": "ctrl+shift+g ctrl+shift+f"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "openGrok.search",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "openGrok.openInEditor",
          "when": "view == openGrokResults && (viewItem == file || viewItem == line)",
          "group": "inline@0"
        },
        {
          "command": "openGrok.commandCopyRelativePath",
          "when": "view == openGrokResults && viewItem != result",
          "group": "inline@1"
        },
        {
          "command": "openGrok.copyBrowserLink",
          "when": "view == openGrokResults",
          "group": "inline@2"
        },
        {
          "command": "openGrok.removeResultItem",
          "when": "view == openGrokResults",
          "group": "inline@3"
        },
        {
          "command": "openGrok.openInEditor",
          "when": "view == openGrokResults && (viewItem == file || viewItem == line)",
          "group": "navigation@0"
        },
        {
          "command": "openGrok.commandCopyRelativePath",
          "when": "view == openGrokResults && (viewItem != result)",
          "group": "3_priority@0"
        },
        {
          "command": "openGrok.copyBrowserLink",
          "when": "view == openGrokResults",
          "group": "3_priority@1"
        },
        {
          "command": "openGrok.removeResultItem",
          "when": "view == openGrokResults",
          "group": "navigation@1"
        },
        {
          "command": "openGrok.saveResult",
          "when": "view == openGrokResults && viewItem == result",
          "group": "inline@4"
        },
        {
          "command": "openGrok.saveResult",
          "when": "view == openGrokResults && viewItem == result",
          "group": "3_priority@2"
        }
      ]
    },
    "views": {
      "openGrokResultsContainer": [
        {
          "id": "openGrokResults",
          "name": "OpenGrok",
          "icon": "images/Icon24x24Dark.svg"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "openGrokResultsContainer",
          "title": "OpenGrok",
          "icon": "images/Icon24x24Dark.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "he": "^1.2.0",
    "node-fetch": "^2.7.0"
  }
}
